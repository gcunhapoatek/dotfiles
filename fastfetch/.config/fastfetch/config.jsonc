{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2,
    },
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "magenta",
    },
    "percent": {
      "type": 2,
      "ndigits": 0,
    },
    "size": {
      "binaryPrefix": "si",
    },
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#31} 󰀄 user   {#keys} │",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#32} 󰇅 host   {#keys} │",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "key": "│ {#33} 󰀵 os     {#keys} │",
      "type": "os",
      "format": "{name} {version}",
    },
    {
      "key": "│ {#34} 󰒋 kernel {#keys} │",
      "type": "kernel",
      "format": "{release}",
    },
    {
      "key": "│ {#35} 󰅐 uptime {#keys} │",
      "type": "uptime",
    },
    {
      "key": "│ {#36} 󰆍 shell  {#keys} │",
      "type": "shell",
      "format": "{pretty-name} {version}",
    },
    {
      "key": "│ {#31}  term   {#keys} │",
      "type": "terminal",
      "format": "{exe-name}",
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#39} 󰏘 colors {#keys} │",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰────────────╯",
      "type": "custom",
    },
  ],
}
