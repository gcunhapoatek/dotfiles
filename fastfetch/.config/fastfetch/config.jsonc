{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // absolute path to ./logo.txt in the config directory
        //"source": "/Users/gabrieldacunha/.config/fastfetch/logo.txt",
        
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "--------------------------------"
        },
        "os",
        "kernel",
        "host",
        "uptime",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "packages",
        "wm",
        {
            "type": "custom",
            "format": "--------------------------------"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ],
    "display": {
        "separator": " -> "
    }
}