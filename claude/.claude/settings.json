{
  "env": {
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "LESS": "-FRX",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)"
    ],
    "ask": [
      "Bash(rg *--pre*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(chmod *777*)",
      "Bash(eval:*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials*)",
      "Read(~/.zshrc.local)",
      "Read(~/.zprofile.local)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.development)",
      "Read(//**/.env.dev)",
      "Read(//**/*.pem)",
      "Read(//**/*id_rsa*)",
      "Read(//**/*id_ed25519*)",
      "Read(//**/*.key)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(//**/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-tool-use.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-tool-use-fs.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Slack__slack_send_message|mcp__claude_ai_Slack__slack_send_message_draft|mcp__claude_ai_Slack__slack_schedule_message|mcp__claude_ai_Slack__slack_create_canvas|mcp__claude_ai_Slack__slack_update_canvas|mcp__claude_ai_Slack__slack_add_reaction",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-tool-use-slack.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-tool-use-shell-lint.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-end-rotate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "padding": 1,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh"
      ]
    },
    "excludedCommands": [
      "gh *",
      "git commit *"
    ]
  },
  "cleanupPeriodDays": 14,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi"
}
