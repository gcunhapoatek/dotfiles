.DS_Store
*.swp
*.swo
*~

# Sensitive files (auth tokens, secrets)
gh/.config/gh/hosts.yml

# Per-machine override files (sourced by their parent config if present).
# These should never be committed; they hold personal/work-specific values.
.gitconfig.local
.zshrc.local
.zprofile.local
*.local

# Tool-managed runtime state we don't want to track
**/configstore/

# Claude Code local overrides and logs (project-local .claude/)
.claude/settings.local.json
.claude/**/*.log

# Global Claude Code stow package — track only curated config.
# Everything else under claude/.claude/ is runtime state / secrets.
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json
!claude/.claude/hooks/
!claude/.claude/skills/
!claude/.claude/agents/
!claude/.claude/commands/
!claude/.claude/keybindings.json
!claude/.claude/statusline.sh
claude/.claude/settings.local.json
claude/.claude/**/*.log
