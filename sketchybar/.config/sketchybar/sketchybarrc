#!/usr/bin/env bash
# SketchyBar config. Docs: https://felixkratz.github.io/SketchyBar/setup
# Catppuccin Mocha. AeroSpace drives workspace highlight via custom event.

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/workspaces.sh"

FONT="FiraCode Nerd Font"

##### Bar Appearance #####
# https://felixkratz.github.io/SketchyBar/config/bar
sketchybar --bar position=top \
                 height=36 \
                 margin=8 \
                 y_offset=6 \
                 corner_radius=10 \
                 border_width=2 \
                 border_color=$SURFACE0 \
                 blur_radius=20 \
                 color=$BAR_COLOR \
                 padding_left=8 \
                 padding_right=8 \
                 shadow=on \
                 sticky=on \
                 topmost=off \
                 notch_width=200

##### Defaults #####
# https://felixkratz.github.io/SketchyBar/config/items
default=(
  padding_left=4
  padding_right=4
  "icon.font=$FONT:Bold:16.0"
  "label.font=$FONT:Semibold:13.0"
  "icon.color=$TEXT"
  "label.color=$TEXT"
  icon.padding_left=8
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=8
  background.corner_radius=6
  background.height=22
)
sketchybar --default "${default[@]}"

##### AeroSpace Workspaces #####
# Driven by plugins/aerospace_events.sh (`aerospace subscribe` bridge, launched
# by aerospace.toml's after-startup-command).
# Per-monitor pills: bar default display=all paints on every monitor; each
# space.$sid.$mon item is scoped via `display=$mon` so each bar shows only its
# monitor's workspaces. $mon is AeroSpace's %{monitor-appkit-nsscreen-screens-id}
# (NSScreen order, matching sketchybar's display numbering) — the plugins use
# that index, never AeroSpace's spatial %{monitor-id}. Plugin recomputes
# assignment + visible workspace per monitor on every event.
# Pills come from workspaces.sh; a pill draws only when its workspace is visible
# or has windows.
# Docs: https://nikitabobko.github.io/AeroSpace/goodies#show-aerospace-workspaces-in-sketchybar
sketchybar --add event aerospace_workspace_change

##### AeroSpace binding mode #####
# Red pill at the far left while a non-main binding mode (e.g. service) is
# active. Fed by mode-changed via plugins/aerospace_events.sh.
sketchybar --add event aerospace_mode_change
sketchybar --add item aerospace_mode left \
           --set aerospace_mode drawing=off \
                                icon.drawing=off \
                                label.color=$CRUST \
                                label.padding_left=8 \
                                background.color=$RED \
                                background.drawing=on \
                                script="$PLUGIN_DIR/aerospace_mode.sh" \
           --subscribe aerospace_mode aerospace_mode_change

# Counted by sketchybar itself, not AeroSpace: the brew service can start before
# the AeroSpace server answers at login, and these are the bars `display=` targets.
MON_COUNT=$(sketchybar --query displays 2>/dev/null | jq length 2>/dev/null)
MON_COUNT=${MON_COUNT:-1}

##### Monitor hot-plug watcher #####
# Per-monitor items (space.*.$mon, front_app.$mon) are created from MON_COUNT at
# load time, so a monitor connect/disconnect needs a `--reload` to recreate them.
# This invisible item watches for layout changes and reloads only when the
# monitor count actually changed (see plugins/monitor_watcher.sh for the guard).
# display_change fires on active-display switch; monitor_change is triggered by
# AeroSpace's focused-monitor-changed event (via plugins/aerospace_events.sh) —
# two detection paths.
sketchybar --add event monitor_change
sketchybar --add item monitor_watcher left \
           --set monitor_watcher drawing=off \
                                 script="$PLUGIN_DIR/monitor_watcher.sh" \
           --subscribe monitor_watcher display_change monitor_change

for mon in $(seq 1 "$MON_COUNT"); do
  for sid in $WORKSPACES; do
    sketchybar --add item space.$sid.$mon left \
               --set space.$sid.$mon \
                  display=$mon \
                  background.color=$SURFACE0 \
                  background.corner_radius=6 \
                  background.height=22 \
                  background.drawing=off \
                  icon="$sid" \
                  icon.drawing=on \
                  icon.font="$FONT:Bold:13.0" \
                  icon.padding_left=8 \
                  icon.padding_right=4 \
                  label="" \
                  label.font="sketchybar-app-font:Regular:14.0" \
                  label.padding_left=0 \
                  label.padding_right=8 \
                  label.y_offset=-1 \
                  click_script="aerospace workspace $sid"
  done
done

# Invisible controller: one event subscription, one batched update for all space.* items.
# Master script does a single `aerospace list-windows --all` and chains --set per workspace.
sketchybar --add item aerospace_controller left \
           --set aerospace_controller drawing=off \
                                      script="$PLUGIN_DIR/aerospace.sh" \
           --subscribe aerospace_controller aerospace_workspace_change

##### Left Items #####
# Separator between the workspace pills and the front_app/media group.
sketchybar --add item space_sep left \
           --set space_sep icon="┊" \
                           icon.color=$OVERLAY0 \
                           icon.font="$FONT:Bold:16.0" \
                           label.drawing=off

# Per-monitor front_app: each bar shows first window of its visible workspace.
# AeroSpace orders windows by tiling tree, not MRU — accuracy caveat documented
# in plugin script.
# aerospace_workspace_change also fires on AeroSpace focus-changed (via
# plugins/aerospace_events.sh), which covers app switches, so the built-in
# front_app_switched is not subscribed (it would double every refresh).
for mon in $(seq 1 "$MON_COUNT"); do
  sketchybar --add item front_app.$mon left \
             --set front_app.$mon \
                display=$mon \
                icon.font="sketchybar-app-font:Regular:16.0" \
                icon.color=$MAUVE \
                label.color=$TEXT \
                script="$PLUGIN_DIR/front_app.sh" \
             --subscribe front_app.$mon aerospace_workspace_change
done

# Separator between the front_app group and now playing.
sketchybar --add item media_sep left \
           --set media_sep icon="┊" \
                           icon.color=$OVERLAY0 \
                           icon.font="$FONT:Bold:16.0" \
                           label.drawing=off

# Now playing — left side, right after the front app. Single item (no display),
# so it shows once per bar. Icon color and media_sep visibility are set by the
# plugin. Event-driven: plugins/media_stream.sh (single-instance, started below)
# streams media-control changes and fires media_update.
sketchybar --add event media_update
sketchybar --add item media left \
           --set media drawing=off \
                       label.max_chars=30 \
                       scroll_texts=on \
                       click_script="media-control toggle-play-pause" \
                       script="$PLUGIN_DIR/media.sh" \
           --subscribe media media_update
"$PLUGIN_DIR/media_stream.sh" >/dev/null 2>&1 &

##### Right Items (rendered right-to-left in declaration order) #####
# https://felixkratz.github.io/SketchyBar/config/events
sketchybar --add item clock right \
           --set clock update_freq=30 \
                       icon="󰥔" \
                       icon.color=$BLUE \
                       click_script="open -a Calendar" \
                       script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock system_woke \
           \
           --add item battery right \
           --set battery update_freq=120 \
                         click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           \
           --add item volume right \
           --set volume icon.color=$PEACH \
                        click_script="open 'x-apple.systempreferences:com.apple.preference.sound'" \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           \
           --add item wifi right \
           --set wifi update_freq=30 \
                      icon.color=$SAPPHIRE \
                      click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
                      script="$PLUGIN_DIR/wifi.sh" \
           --subscribe wifi system_woke \
           \
           --add item weather right \
           --set weather update_freq=900 \
                         icon.color=$YELLOW \
                         script="$PLUGIN_DIR/weather.sh" \
           --subscribe weather system_woke

##### Initial paint #####
sketchybar --update
